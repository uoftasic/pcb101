	(text "SW1: uio[7:0] sets SimProc's UART bit period,\nclk_per_bit = uio x 4. A switch that is on reads 1."
		(exclude_from_sim no)
		(at 152.4 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "91d2db0c-d921-52ed-b427-158f829146ac")
	)
	(text "R1, R2: series resistors. With the kit off and the dongle on,\nR1 limits the current into ui_in[0] to (3.3 - 0.6) V / 1k = 2.7 mA."
		(exclude_from_sim no)
		(at 198.12 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "96932f5c-889a-5212-b66f-31d24f8de56e")
	)
	(text "J4: header for a 3.3 V USB-UART dongle.\nPin 2 goes to the dongle's TXD, pin 3 to its RXD.\nLeave the dongle's VCC unconnected."
		(exclude_from_sim no)
		(at 205.74 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "97b6349d-60b7-57da-9c3a-a6122d0dd0b5")
	)
	(text "RN1: a pull-down on every uio line, so a switch\nthat is off reads 0 rather than floating."
		(exclude_from_sim no)
		(at 152.4 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "d2b60699-2af3-51cc-bd36-c85d38ed5e09")
	)
