# Started from Tiny Tapeout's .gitignore for KiCad (TinyTapeout/tt-demo-pcb at bbf3dd1),
# with the lines KiCad 10 and this repository's CI need added at the end.

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*.kicad_prl
*.sch-bak
*.lck
*~
_autosave-*
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# KiCad 10's local history
.history/

# What ci/build.sh writes; CI uploads it as the run's artifact
out/
